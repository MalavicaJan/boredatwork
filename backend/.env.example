# Copy to .env and fill in. .env is gitignored; this file is not.

DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/boredatwork

# Comma-separated origins allowed to call the API. Must list the
# deployed frontend, or every browser request is blocked by CORS.
ALLOWED_ORIGINS=http://localhost:5173

# True anywhere the site is served over HTTPS. Left false for local
# development, where there is no TLS to send the cookie over.
COOKIE_SECURE=false

# "lax" when the API and the site share an origin (e.g. the API behind
# /api on the same domain) — this also blocks cross-site POSTs, which
# is your CSRF protection. Use "none" only for a cross-origin API, and
# then COOKIE_SECURE must be true and you need your own CSRF token.
COOKIE_SAMESITE=lax
