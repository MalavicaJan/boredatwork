"""Manual connection check: python -m app.check_db_connection

Named this way on purpose: as `database_test.py` pytest collected it and
executed the query at import time, which broke test collection.
"""

from sqlalchemy import text

from app.database import engine


def main() -> None:
    with engine.connect() as connection:
        result = connection.execute(
            text("SELECT current_user, current_database(), version()")
        )
        row = result.fetchone()

        print("Database connection successful!")
        print(f"User: {row[0]}")
        print(f"Database: {row[1]}")
        print(f"PostgreSQL: {row[2]}")


if __name__ == "__main__":
    main()
